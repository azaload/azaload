# Copier ce fichier en `.env` et remplir si besoin.
# Aucune des clés ci-dessous n'est obligatoire pour faire tourner le bot
# (Binance et Yahoo Finance fonctionnent sans clé).

# Sentiment news (https://newsapi.org)
NEWS_API_KEY=

# Source de données alternative (https://www.alphavantage.co)
ALPHA_VANTAGE_API_KEY=

# Notifications optionnelles
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
